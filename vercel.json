{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "fisiotimer.protadev.com"
        }
      ],
      "dest": "/fisiotimer/index.html"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "fisiotimer.protadev.com"
        }
      ],
      "dest": "/fisiotimer/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
