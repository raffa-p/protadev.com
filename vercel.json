{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "fisiotimer.protadev.com"
        }
      ],
      "destination": "/fisiotimer/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "fisiotimer.protadev.com"
        }
      ],
      "destination": "/fisiotimer/:path*"
    }
  ]
}
